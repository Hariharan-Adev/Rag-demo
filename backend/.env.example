# Copy this file to .env for local development.

GROQ_API_KEY=
GROQ_MODEL=
JWT_SECRET_KEY=change-me-locally
ACCESS_TOKEN_EXPIRE_MINUTES=30
RATE_LIMIT_SALT=change-me-locally
CHAT_REQUESTS_PER_HOUR=20
SEARCH_REQUESTS_PER_HOUR=60
UPLOADS_PER_HOUR=5
MAX_FILE_SIZE_MB=25
MAX_ZIP_UPLOAD_MB=50
MAX_ZIP_EXTRACTED_MB=250
MAX_ZIP_FILES=100
MAX_ZIP_COMPRESSION_RATIO=100
MAX_OFFICE_ARCHIVE_ENTRIES=10000
MAX_OFFICE_UNCOMPRESSED_MB=250
MAX_OFFICE_COMPRESSION_RATIO=100
MAX_PDF_PAGES=1000
MAX_POWERPOINT_SLIDES=1000
MAX_WORKBOOK_SHEETS=250
MAX_WORKBOOK_ROWS=200000
PARSER_TIMEOUT_SECONDS=120
INCLUDE_HIDDEN_WORKSHEETS=true
INCLUDE_VERY_HIDDEN_WORKSHEETS=false
GROQ_CALLS_PER_DAY=50
GROQ_DAILY_TOKEN_BUDGET=200000
GROQ_DAILY_COST_CAP_USD=5
GROQ_PROMPT_COST_PER_MILLION=0
GROQ_COMPLETION_COST_PER_MILLION=0
APP_ENVIRONMENT=development
VECTOR_STORE_PROVIDER=qdrant
QDRANT_MODE=remote
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_chunks
# Set QDRANT_MODE=local and use this path for development without Docker.
QDRANT_PATH=./data/qdrant
# Backward-compatible name; QDRANT_PATH takes precedence.
QDRANT_LOCAL_PATH=
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=64
RAG_RETRIEVAL_LIMIT=15
RAG_FINAL_CONTEXT_LIMIT=5
RAG_MIN_SCORE=0.35
INGESTION_MAX_ATTEMPTS=5
INGESTION_LOCK_SECONDS=300
INGESTION_POLL_SECONDS=1
INGESTION_BACKOFF_BASE_SECONDS=2
INGESTION_BACKOFF_MAX_SECONDS=3600
INGESTION_PIPELINE_VERSION=v1
HARD_DELETE_ENABLED=false
EMBEDDING_MODEL_VERSION=all-MiniLM-L6-v2
OPENSEARCH_URL=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=rag_chunks
